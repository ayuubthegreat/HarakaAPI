// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// DATABASE MODEL STRUCTURES USED FOR ALL DATASETS
model User {
  id          String   @id @default(cuid())
  email       String
  username    String?
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  role        Role     @default(USER)
  @@map("allUsers")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
  PENDING_APPROVAL
  BLOCKED
}

// DATASET MODEL 1--HARAKA
model Restaraunt {
  id        String     @id @default(cuid())
  adminIDs  String[]   @default([])
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  menu      MenuItem[]

  @@map("harakaRestaraunts")
}

model MenuItem {
  id           String     @id @default(cuid())
  restarauntId String
  restaraunt   Restaraunt @relation(fields: [restarauntId], references: [id])
  name         String
  price        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("harakaMenuItems")
}

model Order {
  id           String   @id @default(cuid())
  restarauntID String   @default("")
  menuItemID   String
  quantity     Int
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("harakaOrders")
}

// DATASET MODEL 2 --GITSPEDIA and MODEL 3 --MUFTIPEDIA
model ArticleModel {
  id String @id @default(cuid())
  website_name String
  title String
  slug String
  short_desc String
  long_desc String
  main_paragraph String
  content Json?
  infoboxFields Json?
  displayImageContent Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("articleTables")
}
// DATASET MODEL 4---PRETECH (IT COMPANY SERVICE WEBSITE)

model PretechAppointmentModel {
  id        String                   @id @default(cuid())
  name      String
  email     String
  phone     String
  date      DateTime
  service   PretechServiceType       @default(Configuration)
  comment   String?                  @default("")
  status    PretechAppointmentStatus @default(Pending)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @default(now()) @updatedAt

  @@map("pretechAppointments")
}

model PretechAppointmentTime {
  id              String   @id @default(cuid())
  appointmentDate DateTime

  @@map("pretechAppointmentTimes")
}

enum PretechAppointmentStatus {
  Pending
  Confirmed
  Cancelled
}

enum PretechServiceType {
  Configuration
  Repair
}

enum PretechServiceIssueClasses {
  A
  B
  C
  D
}

enum PretechServiceInstallationDifficulty {
  One
  Two
  Three
  Four
}

// DATASET MODEL 5--- CMS Data Model 

model CMSWebsiteProject {
  id           String   @id @default(cuid())
  title        String
  author       String
  shortDesc    String
  description  String
  tags         String
  version_num Float @default(0.0)
  relative_image_link  String @default("src/assets/cmsLogo.png")
  release_date DateTime
  percentage   Int
  version_percentage Int @default(0)
  gitspedia_href String @default("https://www.gitspedia.org")
  @@map("cmsWebsiteProject")
}

// DATASET MODEL 6--- CMS Store Items
model CMSStoreItem {
  id          String   @id @default(cuid())
  name      String @default("Item")
  description String @default("Description")
  price       Float @default(0.0)
  stock       Int @default(0)
  imageContent Json? // Structure: { "relativeUrl": "src/assets/cmsLogo.png", "altText": "CMS Logo" }
  ageRating CMSStoreItemAgeRating @default(AA)
  type CMSStoreItemType @default(Software)
  subscriptionDuration Int @default(-1) // Duration in days (-1 means unlimited, 0 means no subscription)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("cmsStoreItems")
}
enum CMSStoreItemType {
  Book 
  Software
  Video_Game
  Subscription
  Service
}
enum CMSStoreItemAgeRating {
  AA
  TenPlus
  FifteenPlus
  EighteenPlus
}

