// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// DATABASE MODEL STRUCTURES USED FOR ALL DATASETS
model User {
  id          String   @id @default(cuid())
  websiteName String
  email       String   
  username    String?
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  role        Role     @default(USER)

  @@map("allUsers")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

// DATASET MODEL 1--HARAKA
model Restaraunt {
  id        String     @id @default(cuid())
  adminIDs  String[]   @default([])
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  menu      MenuItem[]

  @@map("harakaRestaraunts")
}

model MenuItem {
  id           String     @id @default(cuid())
  restarauntId String
  restaraunt   Restaraunt @relation(fields: [restarauntId], references: [id])
  name         String
  price        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("harakaMenuItems")
}

model Order {
  id           String   @id @default(cuid())
  restarauntID String   @default("")
  menuItemID   String
  quantity     Int
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("harakaOrders")
}

// DATASET MODEL 2 --GITSPEDIA and MODEL 3 --MUFTIPEDIA
model GitspediaArticle {
  id            String                      @id @default(cuid())
  title         String
  searchBlurb   String
  mainParagraph String
  titleImageLink String
  titleImageDescription String @default("")
  paragraphs    GitspediaArticleParagraph[]
  infoboxFields     GitspediaArticleInfobox[]
  comments GitspediaArticleComment[]
  views Int @default(0)
  tags String[]
  updatedAt DateTime @updatedAt @default(now())
  createdAt DateTime @default(now())
  @@map("gitspediaArticles")
}

model GitspediaArticleParagraph {
  id        String           @id @default(cuid())
  articleID String
  article   GitspediaArticle @relation(fields: [articleID], references: [id])
  title     String
  content String

  @@map("gitspediaArticleParagraphs")
}

model GitspediaArticleInfobox {
  id        String           @id @default(cuid())
  articleID String
  article   GitspediaArticle @relation(fields: [articleID], references: [id])
  key     String
  value String

  @@map("gitspediaArticleInfoboxes")
}

model GitspediaArticleComment {
  id        String           @id @default(cuid())
  articleID String 
  article   GitspediaArticle @relation(fields: [articleID], references: [id])
  username String 
  email String 
  message String
  @@map("gitspediaArticleComments")
}
